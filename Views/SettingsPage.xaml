<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="LifeManagementApp.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LifeManagementApp.ViewModels"
             x:DataType="vm:SettingsViewModel"
             Title="Settings">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10">

            <Label Text="Appearance" FontSize="20" FontAttributes="Bold" />
            <Picker Title="Theme"
                    ItemsSource="{Binding Themes}"
                    SelectedItem="{Binding Theme}" />

            <Label  Text="New tasks" FontSize="20" FontAttributes="Bold"
                    Margin="0,16,0,0" />
            <Picker Title="Default category"
                    ItemsSource="{Binding Categories}"
                    SelectedItem="{Binding DefaultCategory}" />
            <Grid ColumnDefinitions="*,Auto">
                <Label  Text="{Binding DefaultPriority, StringFormat='Default priority {0}'}"
                        VerticalOptions="Center" />
                <Stepper Grid.Column="1" Minimum="1" Maximum="5" Increment="1"
                         Value="{Binding DefaultPriority}" />
            </Grid>

            <Label Text="Weather" FontSize="20" FontAttributes="Bold"
                   Margin="0,16,0,0" />
            <Picker Title="City"
                    ItemsSource="{Binding Cities}"
                    SelectedItem="{Binding City}" />
            <Grid ColumnDefinitions="*,Auto">
                <Label  Text="{Binding WindLimit, StringFormat='Kitesurf wind limit {0:0.0} m/s'}"
                        VerticalOptions="Center" />
                <Stepper Grid.Column="1" Minimum="1" Maximum="15" Increment="0.5"
                         Value="{Binding WindLimit}" />
            </Grid>
        
			<Button Text="Reset to defaults" Command="{Binding ResetCommand}" />
            
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>