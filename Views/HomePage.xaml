<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="LifeManagementApp.Views.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:LifeManagementApp.ViewModels"
    xmlns:models="clr-namespace:LifeManagementApp.Models"
    x:DataType="vm:HomeViewModel"
    Title="Home">

    <ScrollView>
    <VerticalStackLayout Padding="16" Spacing="8">
        <!-- Weather -->
        <Label
            FontSize="18"
            FontAttributes="Bold"
            Text="{Binding City, StringFormat='Weather in {0}'}" />

        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

        <Label
            IsVisible="{Binding HasError}"
            Text="{Binding ErrorMessage}"
            TextColor="Red" />

        <VerticalStackLayout IsVisible="{Binding HasWeather}" Spacing="4">
            <Label Text="{Binding Weather.Temperature, StringFormat='Temperature: {0:0.0} °C'}" />
            <Label Text="{Binding Weather.WindSpeed, StringFormat='Wind: {0:0.0} m/s'}" />
        </VerticalStackLayout>

        <Border
            IsVisible="{Binding IsKiteWeather}"
            Padding="12"
            BackgroundColor="Green"
            StrokeShape="RoundRectangle 8">
            <Label
                FontAttributes="Bold"
                TextColor="White"
                Text="{Binding WindLimit, StringFormat='🪁 Kitesurf weather! Wind is over {0:0.0} m/s'}" />
        </Border>

        <Button
            Command="{Binding RefreshCommand}"
            Text="Refresh" />

        <!-- Top 3 To-dos -->
        <Label
            Margin="0,16,0,0"
            FontSize="18"
            FontAttributes="Bold"
            Text="Top 3 To-dos" />

        <CollectionView ItemsSource="{Binding Top3}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:TodoItem">
                    <StackLayout Padding="8" Spacing="4">
                        <Label
                            FontSize="14"
                            FontAttributes="Bold"
                            Text="{Binding Title}" />
                        <Label
                            FontSize="12"
                            Text="{Binding Details}" />
                    </StackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
    </ScrollView>
</ContentPage>

