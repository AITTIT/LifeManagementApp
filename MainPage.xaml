<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:LifeManagementApp"
             x:Class="LifeManagementApp.MainPage"
             xmlns:vm="clr-namespace:LifeManagementApp.ViewModels"
             x:DataType="vm:AddTaskViewModel">

    <ContentPage.Resources>

        <Color x:Key="PrimaryColor">#541A45</Color>
        <local:BoolToColorConverter x:Key="BoolToColorConverter" />
        
        <!--Explicit-->
        <Style x:Key="Headline" TargetType="Label">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>
        
        <!--Implicit-->
        <Style TargetType="Button">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="BackgroundColor" Value="{StaticResource PrimaryColor}"/>
        </Style>
        
    </ContentPage.Resources>
    
    <Grid ColumnDefinitions="*, *"
          RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto, *"
          Padding="20"
          RowSpacing="12"
          ColumnSpacing="12"
          >
        
        <Label Text="New Task"
               Style="{StaticResource Headline}"
               TextColor="{AppThemeBinding Light=#241A45, Dark=White}"
               Grid.Row="0"/>

        <Label  Grid.Row="0" Grid.Column="1"
                Text="{Binding TitleCounter}"
                TextColor="{Binding IsTitleTooLong, Converter={StaticResource BoolToColorConverter}}"
                HorizontalOptions="End" VerticalOptions="End" />

        <Entry  x:Name="TitleEntry" Text="{Binding Title}"
                Placeholder="Title" Grid.ColumnSpan="2" Grid.Row="1"
                ReturnCommand="{Binding SaveCommand}"/>
        
        <Editor Placeholder="Notes" Grid.ColumnSpan="2" Grid.Row="2"
                Text="{Binding Notes}"/>
        
        <Picker Title="Category" Grid.Column="0" Grid.Row="3"
                ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}"/>
        
        <DatePicker Date="{Binding DueDate}" Format="dd.MM.yyyy" Grid.Column="1" Grid.Row="3"/>

        <HorizontalStackLayout Grid.Row="4"
                               Spacing="10">
            
            <Label Text="Reminder" VerticalOptions="Center"/>
            <Switch IsToggled="{Binding Reminder}"/>
        </HorizontalStackLayout>
        
        <HorizontalStackLayout Grid.Row="4"
                               Grid.Column="1"
                               Spacing="10">
            <Label  VerticalOptions="Center" 
                    Text="{Binding Priority, StringFormat='Priority {0}'}"/>
            <Stepper Minimum="1"
                     Maximum="5"
                     Increment="1"
                     Value="{Binding Priority}"
                     />
        </HorizontalStackLayout>
        
        <Button Command="{Binding SaveCommand}" Text="Save" Grid.Row="5" Grid.Column="0" />
        <Button Command="{Binding ClearCommand}" Text="Clear" Grid.Row="5" Grid.Column="1" />

        <Label  Text="{Binding Result}" Grid.Row="6" Grid.ColumnSpan="2"
                TextColor="{StaticResource PrimaryColor}" />

<!--         The list of saved items, unused atm
        <ScrollView Grid.Row="7" Grid.ColumnSpan="2" Orientation="Vertical">
            <VerticalStackLayout x:Name="SavedList" Spacing="8" VerticalOptions="Start"/>
        </ScrollView> -->

    </Grid>
</ContentPage>
